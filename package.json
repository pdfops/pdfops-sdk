{
  "name": "pdfops-sdk",
  "version": "0.7.0",
  "description": "Typed client for the PDFops API: fill, merge and inspect PDF forms over HTTP, plus page operations, text extraction and search, stamping, HTML, Markdown and image to PDF, invoices and e-invoices. Edge-safe: works in Cloudflare Workers, Vercel Edge, Deno, Bun and Node 18+.",
  "keywords": [
    "pdf",
    "acroform",
    "fill-pdf",
    "merge-pdf",
    "split-pdf",
    "pdf-pages",
    "pdf-metadata",
    "pdf-api",
    "edge",
    "cloudflare-workers",
    "vercel-edge",
    "serverless"
  ],
  "homepage": "https://pdfops.dev",
  "bugs": "https://github.com/pdfops/pdfops-sdk/issues",
  "author": "PDFops <hello@pdfops.dev> (https://pdfops.dev)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-transform-types --test \"test/*.test.ts\""
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdfops/pdfops-sdk.git"
  }
}
